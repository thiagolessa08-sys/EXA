# Copie este arquivo para .env e preencha com suas credenciais

# Databricks
DATABRICKS_HOST=https://SEU-WORKSPACE.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/SEU-WAREHOUSE-ID
DATABRICKS_TOKEN=dapi...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Catálogo e schema padrão (opcional, já definido no data_catalog.yaml)
CATALOG=workspace
SCHEMA=default
